# DeepSeek-OCR-WebUI Dockerfile for ARM64 with GPU Support (CUDA)
# For ARM64 Linux servers with NVIDIA GPU
# 
# ⚠️ IMPORTANT: ARM64 CUDA support is limited!
# - NVIDIA Jetson platforms: Fully supported
# - Standard ARM64 servers (AWS Graviton): May not support CUDA
# - If CUDA is not available, consider using x86_64 architecture instead

# Stage 1: Build frontend (if frontend directory exists)
FROM node:20-slim AS frontend-builder
WORKDIR /build
# Copy frontend directory - if it doesn't exist, create empty structure
RUN mkdir -p frontend/dist
COPY frontend ./frontend/
WORKDIR /build/frontend
RUN if [ -f package.json ]; then \
        if [ -f package-lock.json ]; then \
            npm ci; \
        else \
            npm install; \
        fi && \
        npm run build; \
    else \
        echo "No package.json found, keeping empty dist directory"; \
    fi

# Stage 2: Main application (NVIDIA CUDA base image for ARM64)
# Use NVIDIA PyTorch image which should have CUDA support
FROM nvcr.io/nvidia/pytorch:25.09-py3

# 设置环境变量
# Note: This Dockerfile is for ARM64 with NVIDIA GPU (CUDA)
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive \
    VLLM_USE_V1=0 \
    CUDA_VISIBLE_DEVICES=0 \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH \
    CUDA_HOME=/usr/local/cuda \
    HF_HOME=/app/models \
    TRANSFORMERS_CACHE=/app/models \
    FORCE_BACKEND=cuda

WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY requirements.txt .
COPY DeepSeek-OCR-master ./DeepSeek-OCR-master

# 安装 PyTorch with CUDA support (for ARM64 GPU)
# Note: ARM64 CUDA support is limited, mainly for NVIDIA Jetson platforms
RUN pip install --upgrade pip && \
    pip install -r requirements.txt

# 尝试安装支持 CUDA 的 PyTorch
# 如果 NVIDIA 镜像已有 CUDA 支持，这个步骤会跳过
RUN python -c "import torch; print(f'Initial CUDA available: {torch.cuda.is_available()}')" || \
    (echo "PyTorch not found, installing..." && \
     pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121 || \
     pip install torch torchvision torchaudio || \
     echo "⚠️ Failed to install PyTorch")

# 验证 PyTorch CUDA 支持（构建时检查库支持，运行时检查设备）
# 注意：CUDA 设备在构建时不可用，只有在运行时通过 --gpus all 才能访问
RUN python <<EOF
import torch
import sys

print(f"PyTorch version: {torch.__version__}")
print(f"CUDA compiled version: {torch.version.cuda if hasattr(torch.version, 'cuda') and torch.version.cuda else 'N/A'}")

# 检查 PyTorch 是否编译了 CUDA 支持（即使设备不可用）
cuda_compiled = hasattr(torch.version, 'cuda') and torch.version.cuda is not None
cuda_available = torch.cuda.is_available()

if cuda_compiled:
    print("✅ PyTorch is compiled with CUDA support")
    if cuda_available:
        print(f"✅ CUDA device available during build: {torch.cuda.get_device_name(0)}")
    else:
        print("⚠️  CUDA device not available during build (this is normal)")
        print("   CUDA devices are only available at runtime with --gpus all")
else:
    print("⚠️  WARNING: PyTorch may not be compiled with CUDA support")
    print("   This Dockerfile is designed for CUDA support.")
    print("   If CUDA is not available at runtime, you may need to:")
    print("   1. Use Dockerfile.arm64.cuda instead")
    print("   2. Use x86_64 architecture")
    print("   3. Use NVIDIA Jetson platform")
    # Don't exit - let runtime handle CUDA availability
EOF

# 安装 FastAPI 和其他 Web 依赖
RUN pip install \
    fastapi==0.119.1 \
    uvicorn[standard]==0.38.0 \
    python-multipart==0.0.20 \
    python-decouple==3.8

# 预下载模型（关键步骤 - 这会增加镜像大小到约 8GB+）
RUN python -c "from transformers import AutoModel, AutoProcessor; \
    model = AutoModel.from_pretrained('deepseek-ai/DeepSeek-OCR', trust_remote_code=True); \
    processor = AutoProcessor.from_pretrained('deepseek-ai/DeepSeek-OCR', trust_remote_code=True); \
    print('Model downloaded successfully')"

# 复制应用代码
COPY web_service_unified.py .
COPY web_service.py .
COPY web_service_gpu.py .
COPY gpu_manager.py .
COPY ocr_ui_modern.html .
COPY backends ./backends
COPY i18n.js .

# 复制前端构建产物（从构建阶段）
RUN mkdir -p ./frontend/dist
COPY --from=frontend-builder /build/frontend/dist ./frontend/dist

# 暴露端口
EXPOSE 8001

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5m --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# 启动服务（使用 unified 版本，会自动检测 MPS）
CMD ["python", "web_service_unified.py"]

